<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="550.0" prefWidth="750.0" 
            style="-fx-background-color: #0c0c0e;" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="org.appsentinel.infrastructure.adapter.in.gui.controller.AppBlockerController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>
           
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <VBox spacing="4.0">
                            <children>
                                <Label text="APP BLOCKER" style="-fx-text-fill: #ffffff; -fx-font-family: 'system'; -fx-font-weight: bold; -fx-font-size: 22px; -fx-letter-spacing: 1px;" />
                                <Label text="Manage allowed and restricted applications." style="-fx-text-fill: #6c6c73; -fx-font-family: 'system'; -fx-font-size: 12px;" />
                            </children>
                        </VBox>
                 
                        <Region HBox.hgrow="ALWAYS" />
                 
                        <Button fx:id="btnAnadir" mnemonicParsing="false" onAction="#handleAnadirApp" prefHeight="32.0" style="-fx-background-color: #121214; -fx-text-fill: #00e5ff; -fx-border-color: #00e5ff; -fx-border-width: 1px; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-font-family: 'monospace'; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 15 0 15;" text="+ ADD NEW APP" />
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="12.0" VBox.vgrow="ALWAYS">
                    <children>
                 
                        <VBox prefWidth="300.0" spacing="12.0" style="-fx-background-color: #121214; -fx-border-color: #00e5ff; -fx-border-width: 1px; -fx-border-radius: 8px; -fx-background-radius: 8px;" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <Label style="-fx-text-fill: #00e5ff; -fx-font-family: 'monospace'; -fx-font-weight: bold; -fx-font-size: 13px;" text="🛡 WHITE-LIST / WORK APPS" />
                                <ListView fx:id="listaTrabajo" style="-fx-background-color: transparent; -fx-control-inner-background: #121214; -fx-background-radius: 6px; -fx-padding: 2px;" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Button fx:id="btnPasarAOcio" mnemonicParsing="false" onAction="#handlePasarAOcio" prefHeight="30.0" prefWidth="40.0" style="-fx-background-color: #1a1a1e; -fx-text-fill: #00e5ff; -fx-border-color: #333333; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-cursor: hand; -fx-font-weight: bold;" text="&gt;&gt;" />
                                <Button fx:id="btnPasarATrabajo" mnemonicParsing="false" onAction="#handlePasarATrabajo" prefHeight="30.0" prefWidth="40.0" style="-fx-background-color: #1a1a1e; -fx-text-fill: #ff5500; -fx-border-color: #333333; -fx-border-radius: 5px; -fx-background-radius: 5px; -fx-cursor: hand; -fx-font-weight: bold;" text="&lt;&lt;" />
                            </children>
                        </VBox>

                        <VBox prefWidth="300.0" spacing="12.0" style="-fx-background-color: #121214; -fx-border-color: #ff5500; -fx-border-width: 1px; -fx-border-radius: 8px; -fx-background-radius: 8px;" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>
                                <Label style="-fx-text-fill: #ff5500; -fx-font-family: 'monospace'; -fx-font-weight: bold; -fx-font-size: 13px;" text="🚫 BLACK-LIST / BLOCKED APPS" />
                                <ListView fx:id="listaOcio" style="-fx-background-color: transparent; -fx-control-inner-background: #121214; -fx-background-radius: 6px; -fx-padding: 2px;" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                 
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>