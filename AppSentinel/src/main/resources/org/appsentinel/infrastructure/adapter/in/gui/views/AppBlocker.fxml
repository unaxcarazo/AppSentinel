<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" prefHeight="500.0" prefWidth="700.0" 
            styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="org.appsentinel.infrastructure.gui.controller.AppBlockerController">
    <children>
        <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
            </padding>
            <children>
           
                <HBox alignment="CENTER_LEFT" spacing="5.0">
                    <children>
                        <VBox spacing="0.0">
                            <children>
                                <Label fx:id="tituloSeccion" text="APP BLOCKER" />
                                <Label fx:id="subtituloSeccion" text="Manage allowed and restricted applications." />
                            </children>
                        </VBox>
                 
                        <Region HBox.hgrow="ALWAYS" />
                 
                        <HBox alignment="CENTER_RIGHT" spacing="5.0">
                            <children>
                                <TextField fx:id="txtNuevaApp" prefHeight="30.0" prefWidth="180.0" promptText="Proceso (ej: chrome.exe)" />
                                <Button fx:id="btnAnadir" minWidth="80.0" mnemonicParsing="false" onAction="#handleAnadirApp" prefHeight="30.0" text="Añadir App" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                 
                        <VBox styleClass="panel-trabajo" spacing="5.0" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                            </padding>
                            <children>
                                <Label fx:id="labelTrabajo" text="🛡 WHITE-LIST / WORK APPS" />
                                <ListView fx:id="listaTrabajo" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>

                        <VBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Button fx:id="btnPasarAOcio" styleClass="btn-center" minWidth="50.0" mnemonicParsing="false" onAction="#handlePasarAOcio" prefHeight="25.0" text="&gt;&gt;" />
                                <Button fx:id="btnPasarATrabajo" styleClass="btn-center" minWidth="50.0" mnemonicParsing="false" onAction="#handlePasarATrabajo" prefHeight="25.0" text="&lt;&lt;" />
                            </children>
                        </VBox>

                        <VBox styleClass="panel-ocio" spacing="5.0" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                            </padding>
                            <children>
                                <Label fx:id="labelOcio" text="🚫 BLACK-LIST / BLOCKED APPS" />
                                <ListView fx:id="listaOcio" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                 
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>