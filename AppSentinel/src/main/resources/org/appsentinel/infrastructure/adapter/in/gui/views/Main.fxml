<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/25.0.2"
            fx:controller="org.appsentinel.infrastructure.adapter.in.gui.controller.MainController"
            prefWidth="1200" prefHeight="700"
            style="-fx-background-color: #0d1117;"> 

    <left>
        <VBox prefWidth="220" spacing="10" style="-fx-padding: 25 15 25 15; -fx-background-color: #0d1117;">
            <children>
                <Label text="⚡ EXTREMA" style="-fx-text-fill: #ffffff; -fx-font-size: 18; -fx-font-weight: bold; -fx-padding: 0 0 20 5;"/>
                
                <Button fx:id="btnDashboard"
                        text="📊 General Dashboard"
                        styleClass="menu-button"
                        maxWidth="500.0"
                        onAction="#onDashboard"/>
                        
                <Button fx:id="btnAppBlocker"
                        text="🚫 App Blocker"
                        styleClass="menu-button"
                        maxWidth="500.0"
                        onAction="#onAppBlocker"/>
                        
                <Button fx:id="btnDeepFocus"
                        text="🎯 Deep Focus Area"
                        styleClass="menu-button"
                        maxWidth="500.0"
                        onAction="#onDeepFocus"/>
                        
                <Button fx:id="btnPerformance"
                        text="📉 Performance &amp; Processes"
                        styleClass="menu-button"
                        maxWidth="500.0"
                        onAction="#onPerformance"/>
                        
                <Button fx:id="btnHistory"
                        text="🔄 Usage History"
                        styleClass="menu-button"
                        maxWidth="500.0"
                        onAction="#onHistory"/>
                        
                <Region VBox.vgrow="ALWAYS" />
                
                <Button fx:id="btnDeepFocus"
                        text="🛡️ START DEEP FOCUS"
                        styleClass="deep-focus-button-orange" 
                        onAction="#onDeepFocus"
                        maxWidth="500.0"/>
                        
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contenedor" style="-fx-background-color: #0d1117;">
        </StackPane>
    </center>

</BorderPane>