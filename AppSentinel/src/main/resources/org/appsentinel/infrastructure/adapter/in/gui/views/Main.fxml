<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<!-- CORRECCIÓN: Apuntar al paquete exacto de la arquitectura hexagonal -->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.appsentinel.infrastructure.gui.controller.MainController"
            prefWidth="1200" prefHeight="700">

    <!-- SIDEBAR izquierdo -->
    <left>
        <VBox styleClass="sidebar" prefWidth="220">
            <Label text="APPSENTINEL" styleClass="logo"/>
            <Button fx:id="btnDashboard"
                    text="General Dashboard"
                    onAction="#onDashboard"/>
            <Button fx:id="btnAppBlocker"
                    text="App Blocker"
                    onAction="#onAppBlocker"/>
            <Button fx:id="btnPerformance"
                    text="Performance and Processes"
                    onAction="#onPerformance"/>
            <Button fx:id="btnHistory"
                    text="Usage History"
                    onAction="#onHistory"/>
            <Button text="START DEEP FOCUS"
                    styleClass="btnFocus"
                    onAction="#onDeepFocus"/>
        </VBox>
    </left>

    <!-- CONTENEDOR central — aquí carga cada vista -->
    <center>
        <AnchorPane fx:id="contenedor"/>
    </center>

</BorderPane>
