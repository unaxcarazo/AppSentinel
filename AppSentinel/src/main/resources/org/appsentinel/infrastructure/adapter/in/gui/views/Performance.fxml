<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.chart.*?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>

<VBox fx:id="rootPerformance" stylesheets="@extrema.css" spacing="30" styleClass="content-area" 
      xmlns="http://javafx.com/javafx/8" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="org.appsentinel.infrastructure.gui.controller.PerformanceController">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <SVGPath fx:id="iconPulse" content="M2 13h4l3-9 4 18 4-18 3 9h4" strokeWidth="2.5" stroke="#00E5FF" fill="TRANSPARENT" styleClass="perf-icon-pulse"/>
        <VBox spacing="5">
            <Label fx:id="lblTitle" text="PERFORMANCE &amp; PROCESSES" styleClass="page-title"/>
            <Label fx:id="lblSubtitle" text="Real-time system resource monitoring." styleClass="page-subtitle"/>
        </VBox>
    </HBox>

    <!-- Top Metrics -->
    <HBox spacing="20">
        <!-- CPU CARD -->
        <VBox fx:id="cardCpu" styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="15">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <SVGPath content="M4 4h16v16H4V4zm2 2v12h12V6H6zm2 2h8v8H8V8z" style="-fx-fill: #888;"/>
                <Label text="Global CPU Usage" style="-fx-text-fill: #CCC; -fx-font-size: 14px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblCpuPerc" text="24%" styleClass="metric-value" style="-fx-text-fill: #00E5FF; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            </HBox>
            <ProgressBar fx:id="pbCpu" progress="0.24" maxWidth="Infinity" minHeight="12" styleClass="progress-bar, main-perf-bar" style="-fx-accent: #00E5FF;"/>
            <HBox>
                <Label fx:id="lblCpuSpeed" text="3.2 GHz" style="-fx-text-fill: #888; -fx-font-size: 11px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblCpuCores" text="8 Cores" style="-fx-text-fill: #888; -fx-font-size: 11px;"/>
            </HBox>
        </VBox>

        <!-- RAM CARD -->
        <VBox fx:id="cardRam" styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="15">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <SVGPath content="M2 6h20v12H2V6zm2 2v8h16V8H4zm2 2h2v4H6v-4zm4 0h2v4h-2v-4zm4 0h2v4h-2v-4z" style="-fx-fill: #888;"/>
                <Label text="RAM Memory Usage" style="-fx-text-fill: #CCC; -fx-font-size: 14px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblRamPerc" text="42%" styleClass="metric-value" style="-fx-text-fill: #FF3D00; -fx-font-size: 28px; -fx-font-weight: bold;"/>
            </HBox>
            <ProgressBar fx:id="pbRam" progress="0.42" maxWidth="Infinity" minHeight="12" styleClass="progress-bar, main-perf-bar" style="-fx-accent: #FF3D00;"/>
            <HBox>
                <Label fx:id="lblRamUsed" text="6.8 GB In Use" style="-fx-text-fill: #888; -fx-font-size: 11px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblRamTotal" text="16.0 GB Total" style="-fx-text-fill: #888; -fx-font-size: 11px;"/>
            </HBox>
        </VBox>

        <!-- NETWORK CARD -->
        <VBox fx:id="cardNet" styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="5">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <SVGPath content="M12 3L2 12h3v8h14v-8h3L12 3zm0 2.84L17.16 10H15v8H9v-8H6.84L12 5.84z" style="-fx-fill: #888;"/>
                <Label text="Network I/O" style="-fx-text-fill: #CCC; -fx-font-size: 14px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Label fx:id="lblNetDown" text="⬇ 1.2 MB/s" style="-fx-text-fill: #00E5FF; -fx-font-size: 12px;"/>
                    <Label fx:id="lblNetUp" text="⬆ 0.4 MB/s" style="-fx-text-fill: #FF3D00; -fx-font-size: 12px;"/>
                </HBox>
            </HBox>
            <AreaChart fx:id="netChart" prefHeight="80" animated="false" createSymbols="false" legendVisible="false" styleClass="perf-chart">
                <xAxis><NumberAxis forceZeroInRange="false" tickLabelsVisible="false" tickMarkVisible="false" minorTickVisible="false"/></xAxis>
                <yAxis><NumberAxis tickLabelsVisible="false" tickMarkVisible="false" minorTickVisible="false"/></yAxis>
            </AreaChart>
        </VBox>
    </HBox>

    <!-- Table Section -->
    <VBox fx:id="panelTable" spacing="10" styleClass="section-panel" VBox.vgrow="ALWAYS">
        <Label fx:id="lblTableTitle" text="LIVE PROCESS MEMORY &amp; CPU TABLE" styleClass="section-title"/>
        <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="colAppName" text="APP NAME" prefWidth="250"/>
                <TableColumn fx:id="colType" text="TYPE" prefWidth="100"/>
                <TableColumn fx:id="colCpu" text="CPU USAGE %" prefWidth="150"/>
                <TableColumn fx:id="colMem" text="MEMORY %" prefWidth="150"/>
                <TableColumn fx:id="colTime" text="ACTIVE TIME" prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
