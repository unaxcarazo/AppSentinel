{
  "manifest_version": 3,
  "name": "AppSentinel Bridge",
  "version": "1.0",
  "description": "Puente WebSocket para AppSentinel - envía URLs y recibe órdenes de cierre",
  "permissions": ["tabs", "activeTab", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AppSentinel"
  }
}